{
  "manifest_version": 2,
  "id": "org.mai-mai.bilibili-video-parser",
  "version": "1.0.21",
  "name": "B站视频解析",
  "description": "自动识别聊天中的B站视频（BV/av号、bilibili.com链接、b23.tv短链），三级降级解析视频内容：官方AI总结 → 关键帧VLM识别+宿主总结/CC字幕/简介 → 基础信息，解析结果注入消息上下文供bot理解讨论（不刷屏）；另提供 /bili 命令与 parse_bilibili_video 工具显式查询。SESSDATA 可选。",
  "author": {
    "name": "orge-8",
    "url": "https://github.com/orge-8"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/orge-8/bilibili-video-parser"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    { "type": "python_package", "name": "httpx", "version_spec": ">=0.27" },
    { "type": "python_package", "name": "pillow", "version_spec": ">=10.0" }
  ],
  "capabilities": [
    "send.text",
    "llm.generate",
    "api.call"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  }
}
